# GEMINI_API_KEY: Optional key for AI-assisted qualitative explanations
# Fixora functions 100% deterministically without an API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# FIXORA_SESSION_SECRET: Cryptographic secret for signing sessions (optional fallback generated automatically)
FIXORA_SESSION_SECRET="your_cryptographic_session_secret_32_bytes_min"

# SMTP Configuration (Optional): When omitted, Fixora operates in development simulation mode,
# surfacing single-use hashed password reset tokens securely in the UI/dev console for testing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="security@fixora.io"
